# --- Обязательное --------------------------------------------------------

# Ключ шифрования паролей от почтовых ящиков (Fernet, base64, 32 байта).
# Сгенерировать:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Без установленного пакета cryptography — прямо в контейнере:
#   docker run --rm ghcr.io/ttolyanich/imapsync-web:latest \
#     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если не задан — будет сгенерирован при старте и напечатан в лог ОДИН РАЗ.
# Потеряешь ключ — сохранённые пароли превратятся в мусор.
FERNET_KEY=

# Ключ подписи сессий Flask. Если не задан — генерируется и сохраняется
# в файл рядом с БД (чтобы сессии не слетали при каждом рестарте).
SECRET_KEY=

# --- Первый администратор ------------------------------------------------

# Создаётся ТОЛЬКО при первом запуске, дальше пароль меняется в интерфейсе.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Аварийный сброс пароля админа к значению ADMIN_PASSWORD при старте.
# Забыл пароль -> ставишь 1, перезапускаешь контейнер, заходишь, убираешь обратно.
ADMIN_PASSWORD_RESET=0

# --- Прочее --------------------------------------------------------------

# Каталог данных: БД, кэш imapsync, логи, черновики импорта.
DATA_DIR=/data

# Сколько дней хранить сырые логи imapsync (событийная лента в БД живёт всегда).
RAW_LOG_RETENTION_DAYS=14

# Через сколько дней простоя проекта стирать пароли ящиков.
CREDENTIALS_PURGE_DAYS=30

# Часовой пояс для отображения времени.
TZ=Europe/Moscow
